generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}


enum Role {
  CLIENT
  MASTER
  ADMIN
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  ON_REVIEW
  COMPLETED
  UNDER_ARBITRATION
  CANCELLED
}

enum EscrowStatus {
  FROZEN
  RELEASED
  REFUNDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  FROZEN
  RELEASED
  SERVICE_FEE
  REFUND
}

model User {
  id           String        @id @default(cuid())
  firebaseUid  String        @unique
  email        String        @unique
  fullName     String
  role         Role          @default(CLIENT)
  balance      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  ordersAsClient Order[]     @relation("ClientOrders")
  ordersAsMaster Order[]     @relation("MasterOrders")
  transactions   Transaction[]
  payoutRequests PayoutRequest[]
}

model PayoutRequest {
  id           String   @id @default(cuid())
  masterId     String
  master       User     @relation(fields: [masterId], references: [id])
  amount       Float
  cardDetails  String
  status       String   @default("PENDING") // PENDING, PAID, REJECTED
  createdAt    DateTime @default(now())
}


model Order {
  id          String      @id @default(cuid())
  title       String
  description String?
  price       Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  clientId    String
  client      User        @relation("ClientOrders", fields: [clientId], references: [id])
  
  masterId    String
  master      User        @relation("MasterOrders", fields: [masterId], references: [id])

  escrow      Escrow?
  transactions Transaction[]
}

model Escrow {
  id             String       @id @default(cuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id])
  amountTotal    Float
  amountFrozen   Float
  commissionRate Float        @default(0.10) // 10% platform fee
  status         EscrowStatus @default(FROZEN)
  createdAt      DateTime     @default(now())
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  amount      Float
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())
}
